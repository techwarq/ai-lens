{
  "name": "@techwarq/ailens",
  "version": "0.1.4",
  "description": "Developer toolkit that brings software engineering practices to AI apps — debug, diff, type-check, and auto-test your LLM calls",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/esm/index.js",
      "require": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "sideEffects": false,
  "bin": {
    "ailens": "dist/cli/index.js"
  },
  "scripts": {
    "build": "node -e \"require('fs').rmSync('dist',{recursive:true,force:true})\" && tsc && node scripts/build-esm.js",
    "dev": "tsx src/cli/index.ts",
    "typecheck": "tsc --noEmit",
    "test": "node scripts/run-tests.js",
    "smoke": "node scripts/smoke.js",
    "prepublishOnly": "npm run typecheck && npm test && npm run build && npm run smoke"
  },
  "author": "Sonali Nayak",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/techwarq/ai-lens.git"
  },
  "bugs": {
    "url": "https://github.com/techwarq/ai-lens/issues"
  },
  "homepage": "https://github.com/techwarq/ai-lens#readme",
  "keywords": [
    "llm",
    "ai",
    "testing",
    "debugging",
    "prompts",
    "observability",
    "tracing",
    "openai",
    "anthropic",
    "geval"
  ],
  "license": "MIT",
  "files": [
    "dist",
    "README.md",
    "CHANGELOG.md"
  ],
  "devDependencies": {
    "@types/node": "^22.19.17",
    "tsx": "^4.0.0",
    "typescript": "^5.9.3"
  },
  "engines": {
    "node": ">=18"
  }
}
